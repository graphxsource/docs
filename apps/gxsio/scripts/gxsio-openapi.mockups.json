  "MockupRequestOrderProductLocationDto": {
    "type": "object",
    "properties": {
      "LocationName": {
        "type": "string",
        "example": "Full Front"
      },
      "artURL": {
        "type": "string",
        "example": "https://graphxsourcestore.blob.core.windows.net/graphxsourcecontainer/Demo1511201804_28_372355PM.jpg"
      },
      "instructions": {
        "type": "string",
        "example": "",
        "deprecated": true,
        "description": "Deprecated: the artist workflow it fed no longer exists. Accepted and ignored."
      },
      "decorationMethod": {
        "type": "object",
        "example": "Digital Color Print",
        "nullable": true,
        "description": "Decoration method of the location, as named in the supplier catalog (case-insensitive). The mockup is rendered with the size and position of that decoration. Optional for Standard and Premium: without it, a Premium mockup uses the base Premium map of the view."
      },
      "heightInc": {
        "type": "number",
        "example": 3
      },
      "widthInc": {
        "type": "number",
        "example": 2.7
      },
      "effects": {
        "$ref": "#/components/schemas/MockupLocationEffectsDto"
      },
      "gridLines": {
        "$ref": "#/components/schemas/MockupLocationGridLinesDto"
      },
      "drawSmartBackground": {
        "type": "boolean",
        "example": true
      },
      "backgroundColor": {
        "type": "string",
        "example": "#c92490"
      }
    },
    "required": ["LocationName", "artURL"]
  },
  "MockupRequestOrderProductDto": {
    "type": "object",
    "properties": {
      "ProductPartId": {
        "type": "string",
        "example": "1-M0-TShirts-WH"
      },
      "supplierId": {
        "type": "string",
        "example": "7"
      },
      "ProductViewId": {
        "type": "number",
        "example": 0
      },
      "mockupRequestOrderProductLocation": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MockupRequestOrderProductLocationDto"
        }
      }
    },
    "required": [
      "ProductPartId",
      "supplierId",
      "mockupRequestOrderProductLocation"
    ]
  },
  "GetProductMockupRequestExternalDto": {
    "type": "object",
    "properties": {
      "CompanyName": {
        "type": "string",
        "example": "Action Tapes Inc."
      },
      "mockupRequestType": {
        "type": "string",
        "example": "Standard",
        "enum": ["Standard", "Premium"],
        "description": "Standard or Premium (case-insensitive). Premium needs a product view with a Premium template; decorationMethod is optional in both."
      },
      "PONumber": {
        "type": "string",
        "example": "PO1234"
      },
      "OutputFileFormat": {
        "type": "string",
        "example": "",
        "description": "png (default), jpg, jpeg, webp or pdf. Empty means png."
      },
      "pdfPageSize": {
        "$ref": "#/components/schemas/MockupPdfPageSizeDto"
      },
      "ShowBoundingBox": {
        "type": "boolean",
        "example": false
      },
      "measurementFormat": {
        "type": "string",
        "example": "",
        "description": "decimal (default) or fraction. Only used with ShowBoundingBox: true."
      },
      "upscaleTo": {
        "type": "number",
        "example": 1,
        "minimum": 1,
        "maximum": 4
      },
      "mockupRequestOrderProduct": {
        "maxItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MockupRequestOrderProductDto"
        }
      }
    },
    "required": [
      "CompanyName",
      "mockupRequestType",
      "mockupRequestOrderProduct"
    ]
  },
